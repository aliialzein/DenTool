generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String
  role           Role            @default(ADMIN)
  isActive       Boolean         @default(true)
  sessions       Session[]
  passwordResets PasswordReset[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id             String    @id @default(uuid()) @db.Uuid
  otpHash        String
  attempts       Int       @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  resetTokenHash String?
  createdAt      DateTime  @default(now())
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Category {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  description   String?
  imagePublicId String?
  imageUrl      String?
  isActive      Boolean   @default(true)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  slug           String         @unique
  description    String
  price          Decimal        @db.Decimal(10, 2)
  stockQuantity  Int
  isAvailable    Boolean        @default(true)
  isActive       Boolean        @default(true)
  specifications Json?
  useCases       Json?
  categoryId     String         @db.Uuid
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isAvailable])
  @@index([categoryId, isActive])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  publicId  String
  secureUrl String
  sortOrder Int
  createdAt DateTime @default(now())
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}
